# Somente exemplo de desenvolvimento. Nunca versionar .env real.
# Produção: PostgreSQL gerenciado externo, TLS e Secret Manager.
DATABASE_URL=postgresql+asyncpg://devhub:devhub_local_only@127.0.0.1:5432/devhub
DEVHUB_TEST_DATABASE_URL=postgresql+asyncpg://devhub:devhub_local_only@127.0.0.1:5432/devhub_test
DEVHUB_ACCESS_TOKEN=
OPENROUTER_API_KEY=
DEVHUB_OWNER_ID=personal-owner
DEVHUB_OWNER_NAME=Proprietário
DEVHUB_DEFAULT_MODEL=openrouter/free
DEVHUB_MAX_OUTPUT_TOKENS=1024
DEVHUB_MAX_REQUEST_COST_USD=0.05
DEVHUB_DAILY_BUDGET_USD=1.00
DEVHUB_CONTEXT_CHARS=24000
DEVHUB_STREAM_TIMEOUT_SECONDS=240
DEVHUB_STALE_TASK_SECONDS=600
PORT=8080
